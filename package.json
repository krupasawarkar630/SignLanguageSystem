{
  "name": "gestura-monorepo",
  "version": "0.1.0",
  "description": "GESTURA: Real-Time Hand Gesture to Text & Speech Assistive Translator",
  "private": true,
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "python -m uvicorn backend.main:app --reload --port 8000",
    "dev": "concurrently -n \"frontend,backend\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build:frontend": "cd frontend && npm run build",
    "lint:frontend": "cd frontend && npm run lint",
    "typecheck:frontend": "cd frontend && npm run typecheck",
    "test:backend": "python -m pytest backend/tests",
    "test:frontend": "cd frontend && npm test",
    "test": "npm run test:backend && npm run test:frontend && npm run typecheck:frontend",
    "lint": "npm run lint:frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
